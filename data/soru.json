            {
                "uid": "block_1785568103118_5070",
                "type": "paragraf",
                "content": {
                    "html": "<p><b>Fizik bilimi aşağıdaki sorulardan hangisine doğrudan cevap veremez?</b></p>"
                }
            },
            {
                "uid": "block_1785568103118_7832",
                "type": "paragraf",
                "content": {
                    "html": "<p><br><div class=\"question-options-grid\" contenteditable=\"false\"><div class=\"option-box\">\n                        <span class=\"option-prefix\">A)</span>\n                        <div class=\"option-text\" contenteditable=\"true\">Dünyamız nasıl oluştu?</div>\n                    </div><div class=\"option-box\">\n                        <span class=\"option-prefix\">B)</span>\n                        <div class=\"option-text\" contenteditable=\"true\">Gökyüzü neden mavidir?</div>\n                    </div><div class=\"option-box\">\n                        <span class=\"option-prefix\">C)</span>\n                        <div class=\"option-text\" contenteditable=\"true\">Kışın yollara neden tuz dökülür?</div>\n                    </div><div class=\"option-box\">\n                        <span class=\"option-prefix\">D)</span>\n                        <div class=\"option-text\" contenteditable=\"true\">Süt yoğurda nasıl dönüşür?</div>\n                    </div><div class=\"option-box\">\n                        <span class=\"option-prefix\">E)</span>\n                        <div class=\"option-text\" contenteditable=\"true\">Elektrik tellerine konan kuşlara neden elektrik çarpmaz?</div>\n                    </div></div><p><br></p><b></b></p>"
                }
            }
        ]
    },
