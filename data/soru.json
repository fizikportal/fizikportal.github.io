                }
            },
            {
                "uid": "block_1788198223694_4908",
                "type": "paragraf",
                "content": {
                    "html": "<p><br></p>"
                }
            },
            {
                "uid": "block_1788198223694_8588",
                "type": "paragraf",
                "content": {
                    "html": "<div class=\"meta-box meta-hint\" contenteditable=\"false\">\n                    <div class=\"meta-title text-warning\"><i class=\"fa-solid fa-key\"></i> Öğrenci İpucu / Yardımcı Not</div>\n                    <div class=\"meta-content\" contenteditable=\"false\" data-placeholder=\"Öğrenciye yol gösterecek ipucunu buraya yazın...\">Deneylerle doğrulanan hipotezler teoriye dönüşebilir; teoriler veya hipotezler doğrudan \"kanuna\" dönüşmez.</div></div>"
