                    "html": "<table style=\"text-align: center; border-collapse: collapse; border-width: medium; border-style: none; border-color: currentcolor; border-image: none;\"><tbody><tr><th class=\"\" style=\"background: rgb(233, 236, 239); border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Araç Adı&nbsp;</th><th class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78); background: rgb(233, 236, 239);\">Adedi</th></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Dalga leğeni (32 × 38 cm)</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Ayna (33 × 40 cm)</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Buzlu plastik (veya cam) perde&nbsp;</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Ayarlanabilir ayaklar&nbsp;</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">3</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Titreşim motoru (dalga üreteci)</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Stroboskop / flaşör (ayarlanabilir frekanslı ışık)</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Ayarlanabilir DC güç kaynağı</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1 Hz - 1 MHz Frekans Jeneratörü</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Şeffaf plastik cetvel</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Klipsli kablolar ve bağlantı elemanları</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">-</td></tr><tr><td class=\"\" style=\"text-align: left; border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">Kronometre (frekans ölçümü için)</td><td class=\"\" style=\"border-width: 1px; border-style: solid; border-color: rgb(87, 83, 78);\">1</td></tr></tbody></table>"
