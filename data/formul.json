{
  "id": "formul_buyutme",
  "meta": { "konu": "Optik", "baslik": "Büyütme", "birim": "birimsiz", "tarih": "15.09.2026" },
  "latex": "M = \\dfrac{h_g}{h_c} = \\dfrac{d_g}{d_c}",
  "aciklama": "Görüntünün boyu ile cismin boyu oranı, uzaklıklar oranına eşittir.",
  "degiskenler": [
    { "sembol": "M", "anlam": "Büyütme", "birim": "birimsiz" },
    { "sembol": "h_g, h_c", "anlam": "Görüntü ve cisim boyu", "birim": "metre (m)" },
    { "sembol": "d_g, d_c", "anlam": "Görüntü ve cisim uzaklığı", "birim": "metre (m)" }
  ],
  "ornek": { "soru": "d_g = 15 cm, d_c = 30 cm ise büyütme nedir?", "cozum": "M = \\dfrac{15}{30} = 0,5" }
},
{
  "id": "formul_hal_degisim",
  "meta": { "konu": "Isı ve Sıcaklık", "baslik": "Hal Değişim Isısı", "birim": "Joule veya kalori", "tarih": "15.09.2026" },
  "latex": "Q = m \\cdot L",
  "aciklama": "Hal değişimi sırasında sıcaklık sabit kalır; verilen ısı yalnız bağları çözmek için kullanılır.",
  "degiskenler": [
    { "sembol": "Q", "anlam": "Alınan/verilen ısı", "birim": "Joule veya kalori" },
    { "sembol": "m", "anlam": "Kütle", "birim": "kg veya g" },
    { "sembol": "L", "anlam": "Hal değişim ısısı (erime/buharlaşma)", "birim": "J/kg veya cal/g" }
  ],
  "ornek": { "soru": "2 kg buzu eritmek için gereken ısı nedir? (L = 3,34·10⁵ J/kg)", "cozum": "Q = 2 \\times 3,34 \\times 10^5 = 6,68 \\times 10^5 \\, \\text{J}" }
},
{
  "id": "formul_genlesme",
  "meta": { "konu": "Isı ve Sıcaklık", "baslik": "Doğrusal Genleşme", "birim": "metre (m)", "tarih": "15.09.2026" },
  "latex": "\\Delta L = L_0 \\cdot \\lambda \\cdot \\Delta t",
  "aciklama": "Isınan katıların boyu uzar; uzama ilk boy, malzeme katsayısı ve sıcaklık değişimiyle orantılıdır.",
  "degiskenler": [
    { "sembol": "\\Delta L", "anlam": "Boy değişimi", "birim": "metre (m)" },
    { "sembol": "L_0", "anlam": "İlk boy", "birim": "metre (m)" },
    { "sembol": "\\lambda", "anlam": "Genleşme katsayısı", "birim": "1/°C" },
    { "sembol": "\\Delta t", "anlam": "Sıcaklık değişimi", "birim": "°C" }
  ],
  "ornek": { "soru": "2 m çubuk (λ = 1,2·10⁻⁵ 1/°C) 50 °C ısıtılırsa ne kadar uzar?", "cozum": "\\Delta L = 2 \\times 1,2 \\times 10^{-5} \\times 50 = 1,2 \\times 10^{-3} \\, \\text{m}" }
},
{
  "id": "formul_boyle",
  "meta": { "konu": "Basınç ve Kaldırma Kuvveti", "baslik": "Boyle Yasası (Sabit Sıcaklıkta Gaz)", "birim": "atm·L", "tarih": "15.09.2026" },
  "latex": "P_1 \\cdot V_1 = P_2 \\cdot V_2",
  "aciklama": "Sıcaklık sabitken gazın basıncı ile hacmi ters orantılıdır.",
  "degiskenler": [
    { "sembol": "P_1, P_2", "anlam": "İlk ve son basınç", "birim": "atm veya Pa" },
    { "sembol": "V_1, V_2", "anlam": "İlk ve son hacim", "birim": "L veya m³" }
  ],
  "ornek": { "soru": "1 atm'de 6 L olan gaz 2 atm'ye sıkıştırılırsa hacmi ne olur?", "cozum": "1 \\times 6 = 2 \\times V_2 \\Rightarrow V_2 = 3 \\, \\text{L}" }
},
{
  "id": "formul_sureklilik",
  "meta": { "konu": "Basınç ve Kaldırma Kuvveti", "baslik": "Süreklilik Denklemi (Akışkanlar)", "birim": "m³/s", "tarih": "15.09.2026" },
  "latex": "A_1 \\cdot v_1 = A_2 \\cdot v_2",
  "aciklama": "Boruda kesit daraldıkça akış hızı artar; debi her kesitte aynıdır.",
  "degiskenler": [
    { "sembol": "A_1, A_2", "anlam": "Kesit alanları", "birim": "m²" },
    { "sembol": "v_1, v_2", "anlam": "Akış hızları", "birim": "m/s" }
  ],
  "ornek": { "soru": "Kesit 4 m²'den 2 m²'ye inerken hız 2 m/s ise yeni hız nedir?", "cozum": "4 \\times 2 = 2 \\times v_2 \\Rightarrow v_2 = 4 \\, \\text{m/s}" }
},
{
  "id": "formul_foton",
  "meta": { "konu": "Modern Fizik", "baslik": "Foton Enerjisi", "birim": "Joule (J)", "tarih": "15.09.2026" },
  "latex": "E = h \\cdot f",
  "aciklama": "Işığın taşıdığı enerji paketçikleri (fotonlar) frekansla doğru orantılı enerji taşır.",
  "degiskenler": [
    { "sembol": "E", "anlam": "Foton enerjisi", "birim": "Joule (J)" },
    { "sembol": "h", "anlam": "Planck sabiti", "birim": "6,63·10⁻³⁴ J·s" },
    { "sembol": "f", "anlam": "Frekans", "birim": "Hertz (Hz)" }
  ],
  "ornek": { "soru": "f = 5·10¹⁴ Hz ışığın foton enerjisi nedir?", "cozum": "E = 6,63 \\times 10^{-34} \\times 5 \\times 10^{14} \\approx 3,3 \\times 10^{-19} \\, \\text{J}" }
},
{
  "id": "formul_kutle_enerji",
  "meta": { "konu": "Modern Fizik", "baslik": "Kütle–Enerji Eşdeğerliği", "birim": "Joule (J)", "tarih": "15.09.2026" },
  "latex": "E = m \\cdot c^2",
  "aciklama": "Kütle, yoğunlaşmış enerjidir; çok küçük kütleler bile dev enerjiye eşdeğerdir.",
  "degiskenler": [
    { "sembol": "E", "anlam": "Enerji", "birim": "Joule (J)" },
    { "sembol": "m", "anlam": "Kütle", "birim": "kilogram (kg)" },
    { "sembol": "c", "anlam": "Işık hızı", "birim": "3·10⁸ m/s" }
  ],
  "ornek": { "soru": "1 g kütlenin eşdeğer enerjisi nedir?", "cozum": "E = 10^{-3} \\times (3 \\times 10^8)^2 = 9 \\times 10^{13} \\, \\text{J}" }
},
{
  "id": "formul_fotoelektrik",
  "meta": { "konu": "Modern Fizik", "baslik": "Fotoelektrik Olay", "birim": "Joule veya eV", "tarih": "15.09.2026" },
  "latex": "E_k = h \\cdot f - \\Phi",
  "aciklama": "Metalden sökülen elektronun kinetik enerjisi, foton enerjisi ile bağlanma enerjisi (iş fonksiyonu) farkıdır.",
  "degiskenler": [
    { "sembol": "E_k", "anlam": "Elektronun kinetik enerjisi", "birim": "Joule veya eV" },
    { "sembol": "h \\cdot f", "anlam": "Foton enerjisi", "birim": "Joule veya eV" },
    { "sembol": "\\Phi", "anlam": "İş fonksiyonu (bağlanma enerjisi)", "birim": "Joule veya eV" }
  ],
  "ornek": { "soru": "4 eV foton, iş fonksiyonu 2 eV olan metale düşerse elektronun enerjisi nedir?", "cozum": "E_k = 4 - 2 = 2 \\, \\text{eV}" }
} 
]